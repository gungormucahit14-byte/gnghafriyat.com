---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../const/site";
import { localBusinessJson, breadcrumbJson } from "../../lib/schema";
export function getStaticPaths() {
  return [
    { params: { slug: "kepce-kiralama-rehberi" } },
    { params: { slug: "hafriyat-maliyeti-nasil-hesaplanir" } },
    { params: { slug: "jcb-3cx-nedir" } },
  ];
}
const posts: Record<string, { t: string; d: string; h1: string; body: string }> = {
  "kepce-kiralama-rehberi": {
    t: "Kepçe Kiralama Rehberi: Tonaj, Fiyat ve İlçe Seçimi – GNG",
    d: "Kepçe kiralarken mini kepçe mi JCB mi? Tonaj seçimi, saatlik/günlük fiyat mantığı ve Kadıköy'de dikkat edilecekler. 0537 743 61 20",
    h1: "Kepçe Kiralama Rehberi",
    body: `<p>Doğru kepçeyi seçmek paradan çok <strong>zamandan</strong> kazandırır. Kural basit: işinize yeten en küçük makineyi tutun; büyük makine hem pahalı hem dar alanda risktir.</p><h2>Tonaj seçimi: mini, JCB, paletli</h2><ul><li><strong>Mini kepçe (1-3 ton):</strong> dar sokak, bahçe, apartman içi, bodrum molozu. Fikirtepe ara sokakları, site otoparkları ve 1 metrelik kapı geçişleri için tek seçenektir. Treylerle taşınır, yarım günde iş bitirir.</li><li><strong>JCB bekoloder (3CX sınıfı):</strong> önde yükleyici kova, arkada kazıcı kol; hem kazar hem yükler. Temel kazısı, kanal açma, kamyona moloz yükleme ve kırıcı işleri bu makinenin alanıdır. Kadıköy işlerinin çoğu JCB ile çözülür.</li><li><strong>Paletli ekskavatör (15-22 ton):</strong> derin bodrum temelleri, kaya zemini ve büyük hacimli hafriyat. Dar sokağa girmez; geniş şantiye ister.</li></ul><h2>Operatörlü mü operatörsüz mü?</h2><p>Kadıköy'deki işlerin büyük bölümü operatörlü yürür: makine verimli kullanılır, iş kısalır; apartman ve okul çevresinde sigortalı operatör neredeyse zorunludur. G sınıfı belgeniz yoksa operatörsüz kiralamayın — hem mevzuata aykırı hem risklidir. Biz tüm kiralamaları operatörlü yapıyoruz.</p><h2>Fiyat mantığı: saatlik, günlük, haftalık</h2><p>Kısa işlerde saatlik, standart işlerde günlük, şantiyelerde haftalık tarife ekonomiktir. Teklifte şunların ayrı yazıldığını kontrol edin: operatör, yakıt, treyler nakliyesi, sigorta ve döküm ücreti. Kalem kalem yazılmayan teklife imza atmayın. Detay: <a href="/fiyatlar">fiyatlar sayfamız</a>.</p><h2>Kadıköy'de sormayı unutmayın</h2><ul><li>Makine sokağa ve bahçeye girecek mi? (Kapı genişliği, dönüş yarıçapı)</li><li>Site sessiz saatlerine uyulacak mı?</li><li>Molozun döküm fişi verilecek mi?</li></ul><p>Bu üçünü telefonda netleştirin, sürpriz kalmaz: işinizi anlatın, makineyi biz seçelim.</p>`,
  },
  "hafriyat-maliyeti-nasil-hesaplanir": {
    t: "Hafriyat Maliyeti Nasıl Hesaplanır? m³ + Sefer Formülü – GNG",
    d: "Hafriyat maliyeti hesabı: m³ hacim, zemin katsayısı, sefer sayısı ve döküm ücreti. Örnek hesapla şeffaf fiyat mantığı.",
    h1: "Hafriyat Maliyeti Nasıl Hesaplanır?",
    body: `<p>Hafriyat fiyatı dört kalemden oluşur; formül şeffaftır:</p><p><strong>Maliyet = (m³ × zemin katsayısı) + (sefer × km) + döküm ücreti + makine süresi</strong></p><h2>Adım adım hesap</h2><ul><li><strong>1. Hacim:</strong> en × boy × derinlik. 10×8×2 m temel çukuru = 160 m³ banket hacim.</li><li><strong>2. Kabarma payı:</strong> kazılan toprak kabarır; gevşek hacim ~1,25 katıdır (160 → ~200 m³).</li><li><strong>3. Sefer:</strong> 200 ÷ 15 m³ kamyon = ~14 sefer. Kaya zeminde kova verimi düşer, sefer artar.</li><li><strong>4. Mesafe + döküm:</strong> sefer başına km ve lisanslı saha fiş ücreti eklenir.</li></ul><h2>Zemin neden fiyatı değiştirir?</h2><p>Yumuşak toprakta kova dolar taşar; kaya ve betonarme zeminde kırıcı gerekir, saatlik makine süresi uzar. Bu yüzden telefonda zemini sorun, fotoğraf isteyin — ezber fiyat veren firmadan kaçının.</p><h2>Maliyeti düşürmenin 3 yolu</h2><ul><li>Yüklemeyi bekletmeyin: kepçe + kamyon aynı anda sahada olsun, boş bekleme ödemeyin.</li><li>Temiz toprağı sahada dolguda değerlendirin; taşınacak hacim azalır.</li><li>Şantiye bölgesinde komşu parselle sefer birleştirin.</li></ul><p>Net rakam için fotoğraf gönderin, ön fiyatı telefonda verelim. Genel mantık: <a href="/fiyatlar">fiyatlar sayfamız</a>.</p>`,
  },
  "jcb-3cx-nedir": {
    t: "JCB 3CX Nedir? Özellikleri ve Hangi İşe Uyar – GNG Hafriyat",
    d: "JCB 3CX beko loder: ön kepçe + arka kazıcı bir arada. Teknik özellikleri, hangi işlere uygun olduğu ve kiralama bilgisi.",
    h1: "JCB 3CX Nedir?",
    body: `<p><strong>JCB 3CX</strong>, önde yükleyici kovası arkada kazıcı kolu olan beko loderdir; tek makineyle hem kazar hem yükler. Bu yüzden şehir içi hafriyatın en çok kiralanan makinesidir — Kadıköy'deki işlerin büyük bölümü 3CX ile biter.</p><h2>Ne iş yapar?</h2><ul><li>Temel ve kanal kazısı, kotlu tesviye</li><li>Kamyona moloz ve toprak yükleme</li><li>Kırıcı uçla beton-asfalt kırma</li><li>Dar şantiyede tek makineyle komple iş (treyler ile gelir, kurulum istemez)</li></ul><h2>Teknik olarak neden pratik?</h2><p>Lastikli olduğu için paletli gibi treyler rampası ve zemin koruması derdi çıkarmaz; asfalt üstünde yürür. Ön kova ile serme-düzeltme, arka kol ile derin kazı yapılır. Stabilizatör ayakları dar alanda güvenli çalışma sağlar.</p><h2>Ne zaman yetmez?</h2><ul><li>Derin bodrum temelleri ve kaya: paletli ekskavatör gerekir.</li><li>1 metrelik kapı geçişleri ve bina içleri: mini kepçe gerekir.</li><li>Çok büyük hacim: kova başına verim için büyük paletli + çok kamyon.</li></ul><p>Keşifte bunu biz söyleriz; uymayan makineyi göndermeyiz. Kiralama için: <a href="/hizmetler/kiralik-kepce">kiralık kepçe sayfamız</a> ve <a href="/kadikoy-kiralik-kepce">Kadıköy kiralık kepçe</a>.</p>`,
  },
};
const slug = Astro.params.slug ?? "kepce-kiralama-rehberi";
const p = posts[slug] ?? Object.values(posts)[0];
const jsonLd = [localBusinessJson(), breadcrumbJson([{name:"Ana Sayfa",url:SITE.url+"/"},{name:"Blog",url:SITE.url+"/blog"},{name:p.h1,url:SITE.url+"/blog/"+slug}])];
---
<Base title={p.t} description={p.d} jsonLd={jsonLd}>
<div class="wrap"><p class="breadcrumb"><a href="/">Ana Sayfa</a> / <a href="/blog">Blog</a> / {p.h1}</p>
<h1>{p.h1}</h1>
<div set:html={p.body} />
<div class="hero-cta"><a class="btn primary big" href={SITE.phoneHref}>📞 {SITE.phoneDisplay}</a></div>
<p class="muted"><a href="/blog">Tüm yazılar</a> · <a href="/fiyatlar">Fiyatlar</a> · <a href="/kadikoy-kiralik-kepce">Kadıköy Kiralık Kepçe</a></p>
</div>
</Base>
